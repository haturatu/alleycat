FROM golang:1.27.3-alpine AS build
WORKDIR /app
COPY backend/go.mod backend/go.sum ./backend/
WORKDIR /app/backend
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download
COPY backend ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -o /out/site ./cmd/site

FROM alpine:3.24
WORKDIR /app
ARG ALPINE_MIRROR=https://mirrors.xtom.jp/alpine
RUN --mount=type=cache,target=/var/cache/apk,sharing=locked \
    sed -i "s|https://dl-cdn.alpinelinux.org/alpine|${ALPINE_MIRROR}|" /etc/apk/repositories \
    && apk add --cache-packages \
    fontconfig \
    font-noto-all \
    font-noto-cjk-extra \
    font-noto-emoji \
    && fc-cache -f
COPY --from=build /out/site /app/site
COPY frontend /tmp/frontend
COPY frontend/default-public-asset /default-public-asset
RUN if [ -d /tmp/frontend/public ]; then \
      mv /tmp/frontend/public /public \
      && cp /default-public-asset/site.js /public/site.js; \
    fi \
    && rm -rf /tmp/frontend
ENV PUBLIC_DIR=/public
ENV DEFAULT_PUBLIC_DIR=/default-public-asset
EXPOSE 8888
CMD ["/app/site"]
